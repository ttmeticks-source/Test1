-- StarterGui.BlairGui.DragScript
local function C_2c()
local script = G2L["2c"];
	-- BRAND NEW SMOOTH DRAGGING CONTROLLER
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	local screenGui = script.Parent
	local localPlayer = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	
	-- Configuration
	local DRAG_SPEED = 24 -- ⚡ Higher number = faster tracking, Lower number = smoother/quouter look
	
	local function ApplySmoothDrag(frame)
		local dragging = false
		local dragInput = nil
		local dragStart = nil
		local startPos = nil
	
		local targetPosition = frame.Position
	
		-- 🖱️ Trigger click detection
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = frame.Position
	
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
	
		-- 🖐️ Tracking motion adjustments
		frame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
	
		-- 🪐 Smooth physical math framework calculation loop
		RunService.Heartbeat:Connect(function(deltaTime)
			if dragging and dragInput then
				local delta = dragInput.Position - dragStart
	
				-- Calculate exact target destination layout coordinate constraints
				targetPosition = UDim2.new(
					startPos.X.Scale, 
					startPos.X.Offset + delta.X, 
					startPos.Y.Scale, 
					startPos.Y.Offset + delta.Y
				)
			end
	
			-- ✨ Lerp math engine smoothly glides the position every render frame
			if frame.Position ~= targetPosition then
				frame.Position = frame.Position:Lerp(targetPosition, math.clamp(deltaTime * DRAG_SPEED, 0, 1))
			end
		end)
	end
	
	-- 🔍 Automatically attach the smooth dragging logic into your two target frames
	local blairHome = screenGui:WaitForChild("Blair")
	local blairScripts = screenGui:WaitForChild("Blair1")
	
	ApplySmoothDrag(blairHome)
	ApplySmoothDrag(blairScripts)
	
end;
task.spawn(C_2c);
