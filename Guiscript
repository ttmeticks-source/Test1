local function C_2d()
local script = G2L["2d"];
	local screenGui = script.Parent -- 🖥️ BlairGui
	
	-- 🔍 Locate the two windows
	local blairHome = screenGui:WaitForChild("Blair")    -- 🖼️ Home window
	local blairScripts = screenGui:WaitForChild("Blair1")  -- 🖼️ Scripts window
	
	-- 🔍 Locate the master open button
	local aButton = screenGui:WaitForChild("AButton")      -- 🟢 Open button
	
	-- 🔍 Locate the exact Xbuttons inside their specific frames
	local xButtonHome = blairHome:WaitForChild("Xbutton")   
	local xButtonScripts = blairScripts:WaitForChild("Xbutton") 
	
	-- 🔍 Locate the page switching buttons
	local toScriptsButton = blairHome:WaitForChild("ScriptButton") -- 🖱️ Buttons inside Home
	local toHomeButton = blairScripts:WaitForChild("HomeScripts")    -- 🖱️ Buttons inside Blair1
	
	-- Track which page you were looking at last so it reopens to the right spot
	local lastActiveWindow = blairHome
	
	-- ==========================================
	-- 🟢 MASTER OPEN / CLOSE (AButton) LOGIC
	-- ==========================================
	aButton.MouseButton1Click:Connect(function()
		if blairHome.Visible or blairScripts.Visible then
			-- If any menu is currently open, close it
			blairHome.Visible = false
			blairScripts.Visible = false
		else
			-- If everything is hidden, reopen your last active window
			lastActiveWindow.Visible = true
		end
	end)
	
	-- ==========================================
	-- 🟥 INDIVIDUAL CLOSE (Xbutton) LOGIC
	-- ==========================================
	xButtonHome.MouseButton1Click:Connect(function()
		lastActiveWindow = blairHome
		blairHome.Visible = false
	end)
	
	xButtonScripts.MouseButton1Click:Connect(function()
		lastActiveWindow = blairScripts
		blairScripts.Visible = false
	end)
	
	-- ==========================================
	-- 🔀 PAGE SWITCHING LOGIC
	-- ==========================================
	-- Clicking SCRIPTS button inside Blair
	toScriptsButton.MouseButton1Click:Connect(function()
		blairHome.Visible = false
		blairScripts.Visible = true
		lastActiveWindow = blairScripts -- Update memory to Scripts page
	end)
	
	-- Clicking HOME button inside Blair1
	toHomeButton.MouseButton1Click:Connect(function()
		blairScripts.Visible = false
		blairHome.Visible = true
		lastActiveWindow = blairHome -- Update memory to Home page
	end)
	
end;
