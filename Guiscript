	-- 🔀 DYNAMIC BUTTON CONNECTION ENGINE
	-- ==========================================
	local function ConnectAllTabButtons(windowFrame)
		local scriptBtn = windowFrame:FindFirstChild("ScriptButton")
		local homeBtn = windowFrame:FindFirstChild("HomeScripts")
		local infoBtn = windowFrame:FindFirstChild("InfoButton")
		local creditsBtn = windowFrame:FindFirstChild("CreditsButton")
		local closeXBtn = windowFrame:FindFirstChild("Xbutton")
	
		if scriptBtn then
			scriptBtn.MouseButton1Click:Connect(function() SwitchPage(blairScripts) end)
		end
		if homeBtn then
			homeBtn.MouseButton1Click:Connect(function() SwitchPage(blairHome) end)
		end
		if infoBtn then
			infoBtn.MouseButton1Click:Connect(function() SwitchPage(blairInfo) end)
		end
		if creditsBtn then
			creditsBtn.MouseButton1Click:Connect(function() SwitchPage(blairCredits) end)
		end
	
		if closeXBtn then
			closeXBtn.MouseButton1Click:Connect(function()
				lastActiveWindow = windowFrame
				windowFrame.Visible = false
			end)
		end
	end
	
	ConnectAllTabButtons(blairHome)
	ConnectAllTabButtons(blairScripts)
	ConnectAllTabButtons(blairInfo)
	ConnectAllTabButtons(blairCredits)
	
	-- ==========================================
	-- 🟢 MASTER TOGGLE (AButton) LOGIC
	-- ==========================================
	aButton.MouseButton1Click:Connect(function()
		if blairHome.Visible or blairScripts.Visible or blairInfo.Visible or blairCredits.Visible then
			blairHome.Visible = false
			blairScripts.Visible = false
			blairInfo.Visible = false
			blairCredits.Visible = false
		else
			lastActiveWindow.Visible = true
		end
	end)
	
	-- ==========================================
	-- 🖐️ PERFECT SYNC UNIVERSAL SMOOTH DRAGGING
	-- ==========================================
	local RunService = game:GetService("RunService")
	local DRAG_SPEED = 24
	local dragRegistry = {}
	
	local function SyncAllRegistryTargets(activeFrame, finalizedPosition)
		for frame, data in pairs(dragRegistry) do
			if frame ~= activeFrame then
				frame.Position = finalizedPosition
				data.TargetPosition = finalizedPosition
			end
		end
	end
	
	local function ApplyUniversalSmoothDrag(frame)
		local dragging = false
		local dragInput = nil
		local dragStart = nil
		local startPos = nil
	
		local profile = {
			TargetPosition = frame.Position
		}
		dragRegistry[frame] = profile
	
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = frame.Position
	
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						SyncAllRegistryTargets(frame, frame.Position)
					end
				end)
			end
		end)
	
		frame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
	
		RunService.Heartbeat:Connect(function(deltaTime)
			if dragging and dragInput then
				local delta = dragInput.Position - dragStart
				profile.TargetPosition = UDim2.new(
					startPos.X.Scale, 
					startPos.X.Offset + delta.X, 
					startPos.Y.Scale, 
					startPos.Y.Offset + delta.Y
				)
			end
	
			if frame.Position ~= profile.TargetPosition then
				frame.Position = frame.Position:Lerp(profile.TargetPosition, math.clamp(deltaTime * DRAG_SPEED, 0, 1))
			end
		end)
	end
	
	local function InitializeDragSystem()
		for _, child in ipairs(screenGui:GetChildren()) do
			if child:IsA("ImageLabel") then
				ApplyUniversalSmoothDrag(child)
			end
		end
	end
	
	InitializeDragSystem()
	
end;
